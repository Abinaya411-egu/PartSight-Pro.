# Copy this file to .env and fill in values you actually have.
# Never commit a real .env file.

# Local YOLO weights (CPU by default). Leave unchanged if you will use models/best.pt.
PARTSIGHT_MODEL_PATH=models/best.pt
PARTSIGHT_DEVICE=cpu
PARTSIGHT_CONF_THRESHOLD=0.25

# Prototype inspection policy. These are not validated engineering standards.
# Empty detections are never treated as proof a part is safe unless ALLOW_PASS is enabled.
PARTSIGHT_ALLOW_PASS=false
PARTSIGHT_DEFECT_CLASSES=
PARTSIGHT_FAIL_CONFIDENCE=0.50

# Optional hosted inference. Leave blank unless you have a Roboflow workspace model.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=
ROBOFLOW_VERSION=1

# Optional database override used by tests.
# PARTSIGHT_DB_PATH=
